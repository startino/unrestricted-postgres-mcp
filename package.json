{
  "name": "unrestricted-postgres-mcp",
  "version": "0.3.0",
  "description": "Enhanced PostgreSQL MCP Server with full read-write access, transaction recovery, and modern tooling. Fork of mcp-postgres-full-access by Syahiid Nur Kamil.",
  "license": "Apache-2.0",
  "author": {
    "name": "Jonas Lindberg",
    "url": "https://github.com/eksno"
  },
  "contributors": [
    {
      "name": "Syahiid Nur Kamil",
      "url": "https://github.com/syahiidkamil"
    }
  ],
  "homepage": "https://github.com/eksno/unrestricted-postgres-mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eksno/unrestricted-postgres-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/eksno/unrestricted-postgres-mcp/issues"
  },
  "type": "module",
  "bin": {
    "unrestricted-postgres-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && shx chmod +x dist/index.js",
    "dev": "env $(cat .env | xargs) vite-node src/index.ts --watch",
    "preview": "env $(cat .env | xargs) pnpm start",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "postgres",
    "postgresql",
    "database",
    "llm",
    "ai",
    "claude",
    "full-access",
    "write-access",
    "read-write",
    "dml",
    "ddl",
    "schema-explorer",
    "database-manager",
    "sql-executor"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.8.0",
    "express": "^5.1.0",
    "pg": "^8.13.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^20.11.0",
    "@types/pg": "^8.11.10",
    "vitest": "^1.6.0",
    "shx": "^0.3.4",
    "typescript": "^5.6.2",
    "vite": "^7.1.9",
    "vite-node": "^3.2.4"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "imports": {
    "#src/*": "./src/*",
    "#lib/*": "./src/lib/*"
  }
}
